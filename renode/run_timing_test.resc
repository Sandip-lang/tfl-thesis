# run_timing_test.resc
# Renode script for temporal accuracy experiments
# Renode version: 1.15.3
# Author: Sandip Kumar Mourya

mach create "nucleo_f103rb"
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

sysbus LoadELF @firmware/binaries/timing_probe_nucleo_f103rb.elf

showAnalyzer usart2

# Default quantum: 100 microseconds
emulation SetGlobalQuantum "0.0001"

# Log all GPIOA pin changes with virtual timestamps
logLevel -1 gpioPortA

# Write full Renode log to file
logFile @captures/virtual/logs/renode_session.log true

echo "============================================"
echo "  Temporal Accuracy Test - Renode"
echo "  Quantum: 0.0001 s (100 us)"
echo "  Firmware: timing_probe_nucleo_f103rb.elf"
echo "============================================"
echo "Type: start"
